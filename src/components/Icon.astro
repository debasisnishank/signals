---

<svg
  {...rest}
  class={className}
  viewBox={icon.viewBox}
  width={size}
  height={size}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title>{label}</title>}
  {icon.d.map((d) => <path d={d} />)}
</svg>
