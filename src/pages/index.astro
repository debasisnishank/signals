---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import feeds from '../data/feed-cache.json';

const tech = feeds.tech ?? { fetchedAt: null, repos: [], showhn: [] };
const archive = feeds.archive ?? { repos: {}, showhn: {} };

// Group every item by the day it was first seen — that is the log.
const days = new Map();
const bucket = (d) => {
  if (!days.has(d)) days.set(d, { date: d, repos: [], showhn: [] });
  return days.get(d);
};
for (const r of Object.values(archive.repos)) bucket(r.firstSeen).repos.push(r);
for (const h of Object.values(archive.showhn)) bucket(h.firstSeen).showhn.push(h);

for (const d of days.values()) {
  d.repos.sort((a, b) => b.stars - a.stars);
  d.showhn.sort((a, b) => b.points - a.points);
}
const log = [...days.values()].sort((a, b) => (a.date < b.date ? 1 : -1));
const today = (tech.fetchedAt ?? new Date().toISOString()).slice(0, 10);

const fmtDate = (d) =>
  new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', {
    weekday: 'long', month: 'long', day: 'numeric',
  });
const fmtStars = (n) => (n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n));
const gained = (r) => (r.stars ?? 0) - (r.starsAtFirstSeen ?? r.stars ?? 0);

const totalRepos = Object.keys(archive.repos).length;
const description =
  'A dated log of newly released open source — breakout repositories and ' +
  'tools people shipped, recorded on the day each one showed up.';
---

<BaseLayout title="Signals — a dated log of new open source" description={description}>
  <main id="main" class="wrap">
    <a class="back" href="https://debasisnishank.com">&larr; debasisnishank.com</a>

    <header>
      <h1>Signals</h1>
      <p class="lede">
        Open source I'd actually open a tab for — repositories that broke out
        and tools people shipped rather than wrote about. Collected every
        morning and filed under the day it turned up, so this reads as a log
        rather than a leaderboard. Star counts keep updating after the fact.
      </p>
    </header>

    {log.length === 0 && (
      <p class="lede">Nothing recorded yet — the next scheduled run will start the log.</p>
    )}

    {log.map((day) => (
      <section class="day">
        <div class="day__head">
          <h2>{fmtDate(day.date)}</h2>
          {day.date === today && <span class="badge">new today</span>}
        </div>

        {day.repos.length > 0 && (
          <div class="grid">
            {day.repos.map((r) => (
              <article class="card">
                <div class="card__top">
                  <a class="card__name" href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a>
                  <span class="card__stars">{fmtStars(r.stars)}&#9733;</span>
                </div>
                <p class="card__desc">{r.description}</p>
                <div class="card__meta">
                  {r.language && <span class="card__lang">{r.language}</span>}
                  {gained(r) > 0 && <span class="card__gain">+{fmtStars(gained(r))} since</span>}
                </div>
              </article>
            ))}
          </div>
        )}

        {day.showhn.length > 0 && (
          <ul class="list">
            {day.showhn.map((h) => (
              <li class="row">
                <a class="row__title" href={h.url} target="_blank" rel="noopener noreferrer">{h.title}</a>
                <span class="row__meta">
                  Show HN &middot; {h.points} points &middot;{' '}
                  <a href={h.discussion} target="_blank" rel="noopener noreferrer">{h.comments} comments</a>
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}

    <footer class="foot">
      <p>
        {totalRepos} repositories logged so far. Sources: the GitHub search API
        and Hacker News. Rebuilt every morning.
      </p>
      <a href="https://github.com/debasisnishank" target="_blank" rel="noopener noreferrer">
        <Icon name="github" /> Debasis Nishank on GitHub &rarr;
      </a>
    </footer>
  </main>
</BaseLayout>
