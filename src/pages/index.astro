---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import feeds from '../data/feed-cache.json';
import { CATEGORIES, OTHER, categorize } from '../lib/categories.js';

const tech = feeds.tech ?? { fetchedAt: null };
const archive = feeds.archive ?? {};
// Posts used to be Show HN only, under `showhn`; the next refresh migrates them.
const posts = archive.posts ?? Object.fromEntries(
  Object.entries(archive.showhn ?? {}).map(([k, v]) => [k, { source: 'showhn', ...v }]),
);
const SOURCE_LABEL = { showhn: 'Show HN', launchhn: 'Launch HN', hn: 'HN front page' };

// Group every item by the day it was first seen — that is the log.
const days = new Map();
const bucket = (d) => {
  if (!days.has(d)) days.set(d, { date: d, repos: [], posts: [] });
  return days.get(d);
};
for (const r of Object.values(archive.repos ?? {})) bucket(r.firstSeen).repos.push({ ...r, category: categorize(r) });
for (const h of Object.values(posts)) bucket(h.firstSeen).posts.push({ ...h, category: categorize(h) });

for (const d of days.values()) {
  d.repos.sort((a, b) => b.stars - a.stars);
  d.posts.sort((a, b) => b.points - a.points);
}
const log = [...days.values()].sort((a, b) => (a.date < b.date ? 1 : -1));
const today = (tech.fetchedAt ?? new Date().toISOString()).slice(0, 10);

const fmtDate = (d) =>
  new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', {
    weekday: 'long', month: 'long', day: 'numeric',
  });
const fmtStars = (n) => (n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n));
const gained = (r) => (r.stars ?? 0) - (r.starsAtFirstSeen ?? r.stars ?? 0);

// The date navigator: the same days, grouped by month, newest first.
const months = [];
for (const day of log) {
  const key = day.date.slice(0, 7);
  if (months.at(-1)?.key !== key) {
    months.push({
      key,
      label: new Date(key + '-15T12:00:00Z').toLocaleDateString('en-US', { month: 'long', year: 'numeric' }),
      days: [],
    });
  }
  months.at(-1).days.push(day);
}
// Filter chips: only categories that have something in them, busiest first.
const tally = new Map();
for (const day of log) {
  for (const item of [...day.repos, ...day.posts]) {
    tally.set(item.category.id, (tally.get(item.category.id) ?? 0) + 1);
  }
}
const chips = [...CATEGORIES, OTHER]
  .filter((c) => tally.has(c.id))
  .map((c) => ({ ...c, n: tally.get(c.id) }))
  .sort((a, b) => b.n - a.n);
const totalItems = [...tally.values()].reduce((a, b) => a + b, 0);

const dayId = (d) => `d-${d}`;
const fmtNavDay = (d) =>
  new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'short', day: 'numeric' });
const count = (day) => day.repos.length + day.posts.length;

const totalRepos = Object.keys(archive.repos ?? {}).length;
const description =
  'A dated log of newly released open source — breakout repositories and ' +
  'tools people shipped, recorded on the day each one showed up.';
---

<BaseLayout title="Signals — a dated log of new open source" description={description}>
  <main id="main" class="wrap">
    <a class="back" href="https://debasisnishank.com">&larr; debasisnishank.com</a>

    <header>
      <h1>Signals</h1>
      <p class="lede">
        Open source I'd actually open a tab for — repositories that broke out
        and tools people shipped rather than wrote about. Collected every
        morning and filed under the day it turned up, so this reads as a log
        rather than a leaderboard. Star counts keep updating after the fact.
      </p>
    </header>

    {log.length === 0 && (
      <p class="lede">Nothing recorded yet — the next scheduled run will start the log.</p>
    )}

    <div class="layout">
    <div class="log">
    {chips.length > 1 && (
      <div class="chips" role="group" aria-label="Filter by category" hidden>
        <button type="button" class="chip" data-cat="all" aria-pressed="true">
          All <span class="chip__n">{totalItems}</span>
        </button>
        {chips.map((c) => (
          <button type="button" class="chip" data-cat={c.id} aria-pressed="false">
            {c.label} <span class="chip__n">{c.n}</span>
          </button>
        ))}
      </div>
    )}
    {log.map((day) => (
      <section class="day" id={dayId(day.date)}>
        <div class="day__head">
          <h2>{fmtDate(day.date)}</h2>
          {day.date === today && <span class="badge">new today</span>}
        </div>

        {day.repos.length > 0 && (
          <div class="grid">
            {day.repos.map((r) => (
              <article class="card" data-cat={r.category.id}>
                <div class="card__top">
                  <a class="card__name" href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a>
                  <span class="card__stars">{fmtStars(r.stars)}&#9733;</span>
                </div>
                <p class="card__desc">{r.description}</p>
                <div class="card__meta">
                  <span class="tag">{r.category.label}</span>
                  {r.language && <span class="card__lang">{r.language}</span>}
                  {gained(r) > 0 && <span class="card__gain">+{fmtStars(gained(r))} since</span>}
                  {r.hn && (
                    <a class="card__hn" href={r.hn.url} target="_blank" rel="noopener noreferrer">
                      discussed on HN &middot; {r.hn.points} pts
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}

        {day.posts.length > 0 && (
          <ul class="list">
            {day.posts.map((h) => (
              <li class="row" data-cat={h.category.id}>
                <a class="row__title" href={h.url} target="_blank" rel="noopener noreferrer">{h.title}</a>
                <span class="row__meta">
                  <span class="tag">{h.category.label}</span> &middot; {SOURCE_LABEL[h.source] ?? 'HN'} &middot; {h.points} points &middot;{' '}
                  <a href={h.discussion} target="_blank" rel="noopener noreferrer">{h.comments} comments</a>
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
    </div>

    {log.length > 0 && (
      <nav class="dates" aria-label="Jump to date">
        <details class="dates__panel" open>
          <summary>Jump to date</summary>
          {months.map((m, i) => (
            <details class="month" name="months" open={i === 0}>
              <summary>{m.label}</summary>
              <ol>
                {m.days.map((day) => (
                  <li>
                    <a href={`#${dayId(day.date)}`}>
                      <span>{fmtNavDay(day.date)}</span>
                      <span class="dates__count">{count(day)}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          ))}
        </details>
      </nav>
    )}
    </div>

    <footer class="foot">
      <p>
        {totalRepos} repositories logged so far. Sources: the GitHub search API
        and Hacker News. Rebuilt every morning.
      </p>
      <a href="https://github.com/debasisnishank" target="_blank" rel="noopener noreferrer">
        <Icon name="github" /> Debasis Nishank on GitHub &rarr;
      </a>
    </footer>
  </main>

  <script>
    // Category chips. Hidden without JS, since they would do nothing; the
    // choice lives in ?c= so a filtered view can be linked to.
    const chipBar = document.querySelector('.chips');
    if (chipBar) {
      const buttons = [...chipBar.querySelectorAll('.chip')];
      const items = [...document.querySelectorAll('.day [data-cat]')];

      const apply = (cat) => {
        if (!buttons.some((b) => b.dataset.cat === cat)) cat = 'all';
        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.cat === cat));
        for (const el of items) el.hidden = cat !== 'all' && el.dataset.cat !== cat;

        // Drop days, and their navigator entries, that the filter emptied.
        for (const day of document.querySelectorAll('.day')) {
          const shown = day.querySelectorAll('[data-cat]:not([hidden])').length;
          const empty = shown === 0;
          day.hidden = empty;
          for (const block of day.querySelectorAll('.grid, .list')) {
            block.hidden = !block.querySelector('[data-cat]:not([hidden])');
          }
          const link = document.querySelector(`.dates a[href="#${day.id}"]`);
          if (link) {
            link.closest('li').hidden = empty;
            link.querySelector('.dates__count').textContent = String(shown);
          }
        }
        for (const month of document.querySelectorAll('.dates .month')) {
          month.hidden = !month.querySelector('li:not([hidden])');
        }

        const url = new URL(location.href);
        if (cat === 'all') url.searchParams.delete('c');
        else url.searchParams.set('c', cat);
        history.replaceState(null, '', url);
      };

      chipBar.addEventListener('click', (e) => {
        const b = e.target.closest('.chip');
        if (b) apply(b.dataset.cat);
      });
      chipBar.hidden = false;
      apply(new URLSearchParams(location.search).get('c') ?? 'all');
    }

    const nav = document.querySelector('.dates');
    if (nav) {
      // Narrow screens show the navigator above the log, so start it folded;
      // wide screens have no toggle for it, so keep it open there.
      const panel = nav.querySelector('.dates__panel');
      const narrow = matchMedia('(max-width: 959px)');
      const fit = () => panel?.toggleAttribute('open', !narrow.matches);
      fit();
      narrow.addEventListener('change', fit);

      // Mark the day currently being read, opening its month if it was folded.
      const links = new Map(
        [...nav.querySelectorAll('a')].map((a) => [a.getAttribute('href').slice(1), a]),
      );
      let current;
      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const link = links.get(e.target.id);
            if (!link || link === current) continue;
            current?.removeAttribute('aria-current');
            link.setAttribute('aria-current', 'location');
            link.closest('.month')?.setAttribute('open', '');
            current = link;
          }
        },
        { rootMargin: '0px 0px -70% 0px' },
      );
      document.querySelectorAll('.day[id]').forEach((s) => observer.observe(s));

      // One month open at a time. `name` on the <details> does this natively;
      // this covers browsers that predate it.
      const months = [...nav.querySelectorAll('.month')];
      for (const m of months) {
        m.addEventListener('toggle', () => {
          if (m.open) for (const o of months) if (o !== m) o.open = false;
        });
      }
    }
  </script>
</BaseLayout>
